    "autoprefixer": "^10.5.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.56.0",
    "eslint-config-next": "^15.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "happy-dom": "^20.9.0",
    "jsdom": "^29.1.1",
    "next": "^16.2.4",
    "postcss": "^8.5.15",
    "prettier": "^3.2.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.0",
    "uuid": "^14.0.0",
    "vitest": "^4.1.5"
  }
