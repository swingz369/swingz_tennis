{
  "name": "swingz",
  "version": "1.0.0",
  "description": "SWINGZ – Tennisclub Management System",
  "private": true,
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:proxy": "npx tsx scripts/anthropic-openai-proxy.ts",
    "dev:with-proxy": "npx tsx scripts/anthropic-openai-proxy.ts & next dev --turbopack",
    "build": "next build",
    "prebuild": "rm -rf .next",
    "db:status": "npx tsx scripts/migrate.ts status",
    "db:dry": "npx tsx scripts/migrate.ts dry",
    "db:migrate": "npx tsx scripts/migrate.ts up",
    "db:baseline": "npx tsx scripts/migrate.ts baseline",
    "db:status:prod": "MIGRATE_ENV=prod npx tsx scripts/migrate.ts status",
    "db:dry:prod": "MIGRATE_ENV=prod npx tsx scripts/migrate.ts dry",
    "db:migrate:prod": "MIGRATE_ENV=prod npx tsx scripts/migrate.ts up",
    "clean": "rm -rf .next .turbo coverage .drizzle node_modules/.vitest .vitest-cache test-results playwright-report .swc .eslintcache *.tsbuildinfo tsconfig.tsbuildinfo .mdx",
    "clean:all": "rm -rf .next .turbo coverage .drizzle node_modules/.vitest .vitest-cache node_modules/.cache .cache .tmp test-results playwright-report .swc .eslintcache *.tsbuildinfo tsconfig.tsbuildinfo .mdx **/.DS_Store **/Thumbs.db **/*~ **/.~lock.* **/npm-debug.log* **/yarn-error.log* **/*.dump **/*.heap **/*.core **/*.mjs.map",
    "predev": "",
    "start": "next start",
    "lint": "eslint .",
    "check:design": "bash scripts/check-design-tokens.sh",
    "lint:fix": "eslint . --fix",
    "lint:a11y": "eslint . 2>&1 | grep -i 'jsx-a11y' || true",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:integration": "vitest run src/__tests__/",
    "test:setup": "bash scripts/setup-test-db.sh",
    "test:teardown": "docker compose -f docker-compose.test.yml down",
    "test:e2e": "playwright test --project=chromium --project=mobile-chrome",
    "test:e2e:full": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:audit": "QA_AUDIT=1 playwright test --config=playwright.audit.config.ts",
    "test:e2e-browser": "RUN_BROWSER_E2E=true vitest run tests/browser/",
    "bench:ci": "vitest bench tests/bench/clustering.bench.ts",
    "bench:report": "tsx scripts/generate-perf-report.ts",
    "bench:full": "npm run bench:ci && npm run bench:report",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "seed": "npx tsx scripts/seed-testdata.ts",
    "db:restore": "npx tsx scripts/restore-backup.ts",
    "analyze": "ANALYZE=true next build --webpack",
    "gen:types": "bash scripts/gen-supabase-types.sh",
    "gen:types:clean": "bash scripts/clean-supabase-types.sh",
    "prepare": "husky",
    "validate:skills": "tsx scripts/validate-skills.ts",
    "knip": "knip --reporter compact",
    "dead-code": "npm run knip",
    "arch:check": "depcruise app components hooks lib src --config .dependency-cruiser.cjs --cache --ignore-known .dependency-cruiser-known-violations.json",
    "arch:check:all": "depcruise app components hooks lib src --config .dependency-cruiser.cjs --no-ignore-known",
    "arch:baseline": "depcruise app components hooks lib src --config .dependency-cruiser.cjs --output-type baseline --output-to .dependency-cruiser-known-violations.json",
    "arch:graph": "depcruise app components hooks lib src --config .dependency-cruiser.cjs --output-type dot | dot -T svg > dependency-graph.svg",
    "audit:ci": "pnpm audit --audit-level=high",
    "knip:ci": "knip --reporter json",
    "tsc:strict": "tsc --noEmit -p tsconfig.strict.json",
    "tsc:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "docs:autogen": "tsx scripts/docs-autogen.ts",
    "docs:check": "npx tsx scripts/check-docs.ts",
    "contrast:check": "node scripts/check-contrast.mjs",
    "seed:agent": "npx tsx scripts/seed-testdata.ts --lane=agent --yes",
    "seed:reset": "npx tsx scripts/seed-testdata.ts --all --yes",
    "seed:docs": "npx tsx scripts/seed-testdata.ts --docs-only"
  },
  "pnpm": {
    "overrides": {
      "@modelcontextprotocol/sdk": "^1.29.0",
      "esbuild": ">=0.25.0 <1.0.0",
      "postcss": "^8.5.23",
      "sharp": "^0.35.0",
      "dompurify": "^3.4.13",
      "fast-uri": "^3.1.5",
      "joi": "^17.13.4",
      "undici": "^7.29.0",
      "nanoid@3": "^3.3.17",
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@>=4": ">=5.0.9",
      "js-yaml": "^4.3.1"
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@radix-ui/react-accordion": "^1.2.18",
    "@radix-ui/react-avatar": "^1.2.4",
    "@radix-ui/react-checkbox": "^1.3.9",
    "@radix-ui/react-collapsible": "^1.1.18",
    "@radix-ui/react-dialog": "^1.1.21",
    "@radix-ui/react-dropdown-menu": "^2.1.22",
    "@radix-ui/react-popover": "^1.1.21",
    "@radix-ui/react-progress": "^1.1.14",
    "@radix-ui/react-scroll-area": "^1.2.16",
    "@radix-ui/react-select": "^2.3.5",
    "@radix-ui/react-separator": "^1.1.13",
    "@radix-ui/react-slider": "^1.4.5",
    "@radix-ui/react-slot": "^1.3.1",
    "@radix-ui/react-switch": "^1.3.5",
    "@radix-ui/react-tabs": "^1.1.19",
    "@radix-ui/react-toast": "^1.2.21",
    "@radix-ui/react-tooltip": "^1.2.14",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@sentry/nextjs": "^10.67.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.101.4",
    "@tiptap/extension-link": "^3.28.0",
    "@tiptap/extension-placeholder": "^3.28.0",
    "@tiptap/react": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "csv-parse": "^6.2.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.12",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.26.0",
    "next-intl": "^4.13.4",
    "next-swagger-doc": "^0.4.1",
    "next-themes": "^0.4.6",
    "passkit-generator": "^3.5.7",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.82.0",
    "recharts": "^3.10.0",
    "resend": "^6.18.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "stripe": "^22.3.2",
    "swagger-ui-react": "^5.32.11",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@next/bundle-analyzer": "^16.2.11",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/swagger-ui-react": "^5.18.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react-swc": "^4.3.2",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "dependency-cruiser": "^18.2.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.11",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "happy-dom": "^20.11.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "^6.29.0",
    "lint-staged": "^17.2.0",
    "next": "^16.2.11",
    "playwright": "^1.61.1",
    "postcss": "^8.5.22",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.19",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "uuid": "^14.0.1",
    "vitest": "^4.1.10"
  }
}
