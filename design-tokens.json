      "out-expo": "cubic-bezier(0.16, 1, 0.3, 1)"
    },
    "keyframes": {
      "float": "translateY(0 → -12px → 0), 6s ease-in-out infinite",
      "float-slow": "translateY(0 → -8px → 0), 8s ease-in-out infinite",
      "fade-in-up": "opacity 0→1 + translateY(24px→0) + scale(0.98→1), 0.6s",
      "shimmer": "background-position -200%→200%, 2.5s linear infinite",
      "aurora": "translateY(0→-30px→20px) + rotate(0→5°→-3°) + scale(1→1.1→0.95), 15s infinite"
    },
    "prefersReducedMotion": true
  },

