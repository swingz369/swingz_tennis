# ════════════════════════════════════════════════════════════════════════════
# SwingZ E2E Test Environment Variables — TEMPLATE
# ════════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env.test and fill in the real values:
#
#     cp .env.test.example .env.test
#
# The setup script (scripts/setup-test-db.sh) auto-fills the database
# connection values, but you still need to add the test user credentials
# (TEST_ADMIN_*, TEST_MEMBER_*, etc.) by hand below.
#
# .env.test is in .gitignore. NEVER commit real secrets.
#
# Vitest + Playwright both load this file automatically (see
# vitest.config.ts and playwright.config.ts).
# ════════════════════════════════════════════════════════════════════════════

# ─── Dev Server ────────────────────────────────────────────────────────────
# Where the Next.js dev server is running. Default: http://localhost:3000
APP_BASE_URL=http://localhost:3000
# Some specs use BASE_URL as an alias for APP_BASE_URL
BASE_URL=http://localhost:3000

# ─── Local Supabase (option A: full Supabase CLI stack) ───────────────────
# If you ran `bash scripts/setup-supabase.sh`, these point to the
# Supabase local stack. Get the anon/service-role keys from
# `supabase status` or the generated `.env` file in the repo root.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZXYifQ.placeholder_anon_key_replace_me
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZXYiLCJyb2xlIjoic2VydmljZV9yb2xlIn0.placeholder_service_role_key_replace_me
# Used for email redirect URLs, Stripe webhooks, etc.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Local Test Database (option B: plain Docker Postgres) ────────────────
# Auto-filled by scripts/setup-test-db.sh → docker-compose.test.yml
# Container: swingz-test-db, port 54323, user/pass postgres/postgres
DATABASE_URL=postgres://postgres:postgres@localhost:54323/swingz_test

# ─── Rate Limiting Bypass (required for E2E tests) ────────────────────────
# Disables auth/rate-limit middleware so tests can hit login many times.
# Used by the Playwright `webServer` command (DISABLE_RATE_LIMITING=true npm run dev)
# and by the API integration tests.
DISABLE_RATE_LIMITING=true

# ─── Test User Credentials ─────────────────────────────────────────────────
# Required for tests/e2e/* and e2e/*.test.ts via loginAs() / loginAsRoleAware().
#
# How to provision:
#   1. Run `bash scripts/setup-supabase.sh` (full Supabase stack)
#   2. Create users in the Supabase Studio (http://localhost:54323)
#      with these exact emails and passwords
#   3. Set their roles via SQL or Studio (admin / superadmin / member / trainer)
#   4. OR: seed a test billing user with `npx tsx scripts/seed-test-billing-user.ts`
#      which prints TEST_MEMBER_UUID / TEST_MEMBER_EMAIL / TEST_MEMBER_PASSWORD
#
# All four role users are required for the full test matrix.

TEST_ADMIN_EMAIL=admin@test.swingz.local
TEST_ADMIN_PASSWORD=AdminPass123!

TEST_SUPERADMIN_EMAIL=superadmin@test.swingz.local
TEST_SUPERADMIN_PASSWORD=SuperAdminPass123!

TEST_MEMBER_EMAIL=member@test.swingz.local
TEST_MEMBER_PASSWORD=MemberPass123!

TEST_TRAINER_EMAIL=trainer@test.swingz.local
TEST_TRAINER_PASSWORD=TrainerPass123!

# For Stripe-checkout tests (uses a different email domain to avoid
# collisions with the regular member test user).
E2E_TEST_MEMBER_EMAIL=test-member@swingz.de
E2E_TEST_MEMBER_PASSWORD=SwingZTest123!

# UUID of the test billing user (output of `scripts/seed-test-billing-user.ts`).
# Used by billing-engine tests to skip seeding the user on every run.
TEST_MEMBER_UUID=00000000-0000-0000-0000-000000000001

# ─── Midscene AI (for e2e/*.test.ts that use aiAct / aiQuery) ──────────────
# Required for the Midscene-based E2E tests:
#   e2e/admin-season-wizard.test.ts
#   e2e/member-lifecycle.test.ts
#   e2e/season-planning-backtracking.test.ts
#   e2e/trainer-availability.test.ts
# Get an OpenAI key at: https://platform.openai.com/api-keys
# Gemini is also supported (use MIDSCENE_MODEL_NAME=gemini-1.5-pro + Google API key).
OPENAI_API_KEY=sk-replace-me-with-your-openai-key
MIDSCENE_MODEL_NAME=gpt-4o

# ─── Optional: Manual Supabase Session Auth (advanced) ────────────────────
# For tests that bypass the loginAs helper and inject a session directly
# into the browser. Open DevTools → Application → Cookies on
# http://localhost:54321 after logging in to find the actual cookie names.
# SUPABASE_SESSION_TOKEN=
# SUPABASE_REFRESH_TOKEN=

# ─── Optional: Test-mode cookie (bypasses rate limiting in middleware) ────
# Some integration tests set this cookie to disable rate-limit checks
# without setting DISABLE_RATE_LIMITING globally. Value is the literal
# string `true` set as `swingz_test_mode=true`.
# SWINGZ_TEST_MODE=true
