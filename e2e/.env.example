# Midscene E2E Test Configuration
# Copy this to .env and fill in the values

# Required: OpenAI API Key for Midscene AI
# MIDSCENE_MODEL_NAME="gpt-4o"
# OPENAI_API_KEY="sk-..."

# Optional: Dev-Server URL (default: http://localhost:3000)
# BASE_URL="http://localhost:3000"

# Optional: Season-ID for the Wizard test (if known)
# SEASON_ID="..."

# Optional: Supabase Auth (if not already logged in)
# Cookie names may vary depending on Supabase setup.
# Check the actual cookie names in Browser DevTools
# (Application → Cookies) and adjust if needed.
# SUPABASE_SESSION_TOKEN="..."
# SUPABASE_REFRESH_TOKEN="..."
