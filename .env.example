# Supabase
NEXT_PUBLIC_SUPABASE_URL=<your-project-ref.supabase.co>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# OAuth (optional - for GitHub login)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Email (optional - for sending emails via Resend)
# RESEND_API_KEY=<your-resend-key>
# EMAIL_FROM=noreply@yourclub.com

# Sentry (optional - for error tracking)
# SENTRY_DSN=

# Analytics (optional)
# GOOGLE_ANALYTICS_ID=

# Rate Limiting (optional - defaults to in-memory for dev)
# For production, use Upstash Redis:
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token

# Feature Flags (Phase 2 Service Migration - Production Ready)
# Enable repository pattern (Drizzle ORM) instead of in-memory services
# Rollout Strategy: Start with false, test at 25%, 50%, then 100%
# USE_BILLING_REPOSITORY=false
# USE_ATTENDANCE_REPOSITORY=false
# USE_AVAILABILITY_REPOSITORY=false
# USE_ABSENCE_REPOSITORY=false
# USE_FEE_CONFIG_REPOSITORY=false
# USE_PAYMENT_SETTINGS_REPOSITORY=false
# USE_SYSTEM_SETTINGS_REPOSITORY=false
# USE_TRIAL_TRAINING_REPOSITORY=false
# USE_TRAINER_PROFILE_REPOSITORY=false
# USE_HOURLY_RATE_REPOSITORY=false
# USE_SEPA_MANDATE_REPOSITORY=false

# White-label Branding (Weeks 3-4)
CUSTOM_DOMAINS={}
ZAPIER_WEBHOOK_URL=
# MAILCHIMP_WEBHOOK_URL - planned for newsletter integration (not yet implemented)
MAILCHIMP_WEBHOOK_URL=
TWILIO_SMS_ENABLED=false

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
