[TEMPLATE]
# =============================================================================
# Supabase (Required)
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=<your-project-ref.supabase.co>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Optional: Direct database connection (for Drizzle ORM migrations)
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres
# DIRECT_URL=postgresql://postgres:<password>@<host>:5432/postgres

# =============================================================================
# Stripe Payment (Optional — app works without it)
# When STRIPE_SECRET_KEY is absent or placeholder, payments are auto-confirmed.
# =============================================================================
# Get these from https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_ENTERPRISE=price_xxx

# Get this from Stripe Dashboard → Webhooks → Add Endpoint → Signing Secret
# Webhook URL: https://yourdomain.com/api/stripe/webhook
# Events to listen for: checkout.session.completed, payment_intent.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# =============================================================================
# Email — Resend (Optional)
# Emails are skipped gracefully when RESEND_API_KEY is not configured.
# =============================================================================
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=SwingZ <noreply@swingz.app>
# EMAIL_REPLY_TO=support@yourclub.com

# =============================================================================
# Rate Limiting — Upstash Redis (Optional — falls back to in-memory for dev)
# =============================================================================
# Get from https://console.upstash.com → Redis → Details
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# =============================================================================
# E2E Test Credentials (for Playwright tests)
# Create these users in your Supabase database before running E2E tests
# =============================================================================
TEST_ADMIN_EMAIL=admin@test.swingz.com
TEST_ADMIN_PASSWORD=TestAdmin123!
TEST_MEMBER_EMAIL=member@test.swingz.com
TEST_MEMBER_PASSWORD=TestMember123!
TEST_SUPERADMIN_EMAIL=superadmin@test.swingz.com
TEST_SUPERADMIN_PASSWORD=TestSuper123!
TEST_TRAINER_EMAIL=trainer@test.swingz.com
TEST_TRAINER_PASSWORD=TestTrainer123!
TEST_MEMBER_UUID=<uuid-from-supabase>

# =============================================================================
# OAuth (Optional — for GitHub login)
# =============================================================================
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# =============================================================================
# AI Features (Optional)
# Used by lib/ai/schedule-generator.ts and lib/ai/schedule-generator-v2.ts
# =============================================================================
ANTHROPIC_API_KEY=sk-ant-your-key
# OPENAI_API_KEY=sk-your-key

# =============================================================================
# Monitoring & Error Tracking (Optional)
# =============================================================================
# Sentry (https://sentry.io)
# SENTRY_DSN=https://xxx@sentry.io/xxx
# SENTRY_AUTH_TOKEN=

# Google Analytics — used by components/analytics-provider.tsx
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# A/B Experiment overrides (optional) — comma-separated experiment:variant pairs
# See lib/experiments.ts for available experiments
# NEXT_PUBLIC_EXPERIMENTS=landing_hero_cta:pricing_layout

# =============================================================================
# Feature Flags (Phase 2 Service Migration — Production Ready)
# Enable repository pattern (Drizzle ORM) instead of in-memory services.
# Rollout Strategy: Start with false, test at 25%, 50%, then 100%.
# =============================================================================
USE_BILLING_REPOSITORY=false
USE_ATTENDANCE_REPOSITORY=false
USE_AVAILABILITY_REPOSITORY=false
USE_ABSENCE_REPOSITORY=false
USE_FEE_CONFIG_REPOSITORY=false
USE_PAYMENT_SETTINGS_REPOSITORY=false
USE_SYSTEM_SETTINGS_REPOSITORY=false
USE_TRIAL_TRAINING_REPOSITORY=false
USE_TRAINER_PROFILE_REPOSITORY=false
USE_HOURLY_RATE_REPOSITORY=false
USE_SEPA_MANDATE_REPOSITORY=false

# =============================================================================
# White-label & Integrations (Optional)
# =============================================================================
# CUSTOM_DOMAINS={}
ZAPIER_WEBHOOK_SECRET=whsec_your_zapier_secret
# ZAPIER_WEBHOOK_URL=
# MAILCHIMP_WEBHOOK_URL=
# TWILIO_SMS_ENABLED=false

# =============================================================================
# SEPA Creditor Configuration (required for SEPA direct debit generation)
# =============================================================================
# SEPA_CREDITOR_NAME=Mein Tennis Club e.V.
# SEPA_CREDITOR_IBAN=DE89370400440532013000
# SEPA_CREDITOR_ID=DE98ZZZ09999999999
# SEPA_CREDITOR_BIC=COBADEFFXXX
# SEPA_CREDITOR_STREET=Musterstraße 1
# SEPA_CREDITOR_CITY=Berlin
# SEPA_CREDITOR_POSTAL_CODE=10115
# SEPA_CREDITOR_COUNTRY=DE

# =============================================================================
# Cron Job Security
# =============================================================================
# CRON_SECRET=generate-a-random-secret-with-openssl-rand-hex-32

# =============================================================================
# App Configuration
# =============================================================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
