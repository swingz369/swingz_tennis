              "path": ["api", "clubs"]
            }
          }
        }
      ]
    },
    {
      "name": "Analytics",
      "item": [
        {
          "name": "Get Analytics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/analytics?clubId={{club_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "analytics"],
              "query": [
                {
                  "key": "clubId",
                  "value": "{{club_id}}"
                }
              ]
            }
          }
        },
        {
          "name": "Get Dashboard KPIs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/dashboard/kpis?clubId={{club_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "dashboard", "kpis"],
              "query": [
                {
                  "key": "clubId",
                  "value": "{{club_id}}"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "System",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/health",
              "host": ["{{base_url}}"],
              "path": ["api", "health"]
            }
          }
        }
      ]
    }
  ]
}
