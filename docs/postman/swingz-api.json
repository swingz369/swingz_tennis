{
  "info": {
    "name": "SwingZ API",
    "description": "Complete API collection for SwingZ Tennis Club Management System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "2.0.0"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://swingz.vercel.app",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "csrf_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "club_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "pm.environment.set('access_token', response.session.access_token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"superadmin@swingz.com\",\n  \"password\": \"your-password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Get CSRF Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "pm.environment.set('csrf_token', response.csrfToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/csrf-token",
              "host": ["{{base_url}}"],
              "path": ["api", "csrf-token"]
            }
          }
        }
      ]
    },
    {
      "name": "Members",
      "item": [
        {
          "name": "List Members",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/members?clubId={{club_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "members"],
              "query": [
                {
                  "key": "clubId",
                  "value": "{{club_id}}"
                }
              ]
            }
          }
        },
        {
          "name": "Create Member",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.sendRequest({",
                  "    url: pm.environment.get('base_url') + '/api/csrf-token',",
                  "    method: 'GET'",
                  "}, (err, res) => {",
                  "    pm.environment.set('csrf_token', res.json().csrfToken);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newmember@example.com\",\n  \"name\": \"New Member\",\n  \"clubId\": \"{{club_id}}\",\n  \"password\": \"SecurePassword123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/members",
              "host": ["{{base_url}}"],
              "path": ["api", "members"]
            }
          }
        },
        {
          "name": "Bulk Deactivate Members",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.sendRequest({",
                  "    url: pm.environment.get('base_url') + '/api/csrf-token',",
                  "    method: 'GET'",
                  "}, (err, res) => {",
                  "    pm.environment.set('csrf_token', res.json().csrfToken);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"memberIds\": [\n    \"uuid1\",\n    \"uuid2\"\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/members/bulk-deactivate",
              "host": ["{{base_url}}"],
              "path": ["api", "members", "bulk-deactivate"]
            }
          }
        }
      ]
    },
    {
      "name": "Sessions",
      "item": [
        {
          "name": "List Sessions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/sessions?clubId={{club_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "sessions"],
              "query": [
                {
                  "key": "clubId",
                  "value": "{{club_id}}"
                }
              ]
            }
          }
        },
        {
          "name": "Create Session",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.sendRequest({",
                  "    url: pm.environment.get('base_url') + '/api/csrf-token',",
                  "    method: 'GET'",
                  "}, (err, res) => {",
                  "    pm.environment.set('csrf_token', res.json().csrfToken);",
                  "});"
                ],
                "type": "text/javascript"
              }
