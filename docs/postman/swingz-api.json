              {
                "key": "X-CSRF-Token",
                "value": "{{csrf_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dayOfWeek\": 1,\n  \"startTime\": \"09:00\",\n  \"endTime\": \"10:00\",\n  \"trainerId\": \"trainer-uuid\",\n  \"maxParticipants\": 8,\n  \"notes\": \"Beginner group\",\n  \"clubId\": \"{{club_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/sessions",
              "host": ["{{base_url}}"],
              "path": ["api", "sessions"]
            }
          }
        },
        {
          "name": "Bulk Delete Sessions",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.sendRequest({",
                  "    url: pm.environment.get('base_url') + '/api/csrf-token',",
                  "    method: 'GET'",
                  "}, (err, res) => {",
                  "    pm.environment.set('csrf_token', res.json().csrfToken);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionIds\": [\n    \"uuid1\",\n    \"uuid2\"\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/sessions/bulk-delete",
              "host": ["{{base_url}}"],
              "path": ["api", "sessions", "bulk-delete"]
            }
          }
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "List Bookings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/bookings?memberId=member-uuid",
              "host": ["{{base_url}}"],
              "path": ["api", "bookings"],
              "query": [
                {
                  "key": "memberId",
                  "value": "member-uuid"
                }
              ]
            }
          }
        },
        {
          "name": "Create Booking",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.sendRequest({",
                  "    url: pm.environment.get('base_url') + '/api/csrf-token',",
                  "    method: 'GET'",
                  "}, (err, res) => {",
                  "    pm.environment.set('csrf_token', res.json().csrfToken);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"session-uuid\",\n  \"memberId\": \"member-uuid\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/bookings",
              "host": ["{{base_url}}"],
              "path": ["api", "bookings"]
            }
          }
        },
        {
          "name": "Cancel Booking",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.sendRequest({",
                  "    url: pm.environment.get('base_url') + '/api/csrf-token',",
                  "    method: 'GET'",
                  "}, (err, res) => {",
                  "    pm.environment.set('csrf_token', res.json().csrfToken);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/bookings/booking-uuid/cancel",
              "host": ["{{base_url}}"],
              "path": ["api", "bookings", "booking-uuid", "cancel"]
            }
          }
        }
      ]
    },
    {
      "name": "Clubs",
      "item": [
        {
          "name": "List Clubs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/clubs",
              "host": ["{{base_url}}"],
              "path": ["api", "clubs"]
            }
          }
        },
        {
          "name": "Create Club",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.sendRequest({",
                  "    url: pm.environment.get('base_url') + '/api/csrf-token',",
                  "    method: 'GET'",
                  "}, (err, res) => {",
                  "    pm.environment.set('csrf_token', res.json().csrfToken);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
