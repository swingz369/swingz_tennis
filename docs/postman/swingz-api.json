              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tennis Club Berlin\",\n  \"address\": \"Hauptstraße 1, 10115 Berlin\",\n  \"contact_email\": \"info@club.de\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/clubs",
