{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app/**/page.tsx",
    "app/**/layout.tsx",
    "app/**/route.ts",
    "app/**/loading.tsx",
    "app/**/error.tsx",
    "app/**/not-found.tsx",
    "app/**/global-error.tsx",
    "app/**/icon.tsx",
    "proxy.ts",
    "next.config.js",
    "next.config.ts",
    "next.config.mjs",
    "sentry.client.config.ts",
    "sentry.server.config.ts",
    "sentry.edge.config.ts",
    "drizzle.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "playwright.audit.config.ts",
    "scripts/**/*.ts",
    "scripts/**/*.mjs",
    "scripts/**/*.sh",
    "scripts/**/*.py",
    ".tours/**/*.tour",
    ".agents/**/*.md"
  ],
  "ignore": [
    "drizzle/**",
    ".next/**",
    "graphify-out/**",
    "ds-bundle/**",
    ".ds-sync/**",
    ".audit-captures/**",
    "playwright-report/**",
    "midscene_run/**",
    ".claude/**",
    "supabase/.branches/**",
    "supabase/functions/**",
    "next-env.d.ts",
    "**/*.d.ts",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.test.ts",
    "**/*.test.tsx"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": ["@anthropic-ai/sdk"],
  "includeEntryExports": true,
  "exclude": []
}
