{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app/**/page.tsx",
    "app/**/layout.tsx",
    "app/**/route.ts",
    "app/**/loading.tsx",
    "app/**/error.tsx",
    "app/**/not-found.tsx",
    "app/**/global-error.tsx",
    "app/**/icon.tsx",
    "proxy.ts",
    "next.config.js",
    "next.config.ts",
    "next.config.mjs",
    "sentry.client.config.ts",
    "sentry.server.config.ts",
    "sentry.edge.config.ts",
    "drizzle.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "playwright.audit.config.ts",
    "scripts/**/*.ts",
    "scripts/**/*.mjs",
    "scripts/**/*.sh",
    "scripts/**/*.py",
    ".tours/**/*.tour",
    ".agents/**/*.md"
  ],
  "ignore": [
    "drizzle/**",
    ".next/**",
    "graphify-out/**",
    "ds-bundle/**",
    ".ds-sync/**",
    ".design-sync/**",
    ".audit-captures/**",
    "playwright-report/**",
    "midscene_run/**",
    ".claude/**",
    "supabase/.branches/**",
    "supabase/functions/**",
    "types/supabase.ts",
    // Test-Infrastruktur: vitest-Alias (server-only) bzw. vom ignored-Test-Suites
    // genutzte Helfer (web-test) — knip zählt Importe aus *.test.ts nicht.
    "src/__tests__/mocks/server-only.ts",
    "tests/helpers/web-test.ts",
    "next-env.d.ts",
    "**/*.d.ts",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.test.ts",
    "**/*.test.tsx"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "@anthropic-ai/sdk",
    // eslint-plugin-jsx-a11y wird in eslint.config.ts referenziert (Flat Config),
    // tsx wird von npm-Scripts benötigt (devDependency, z. B. seed/restore-backup).
    "eslint-plugin-jsx-a11y",
    "tsx"
  ],
  "includeEntryExports": true,
  "exclude": []
}
