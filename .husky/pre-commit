#!/usr/bin/env sh
# ═══ Husky pre-commit Hook ═══════════════════════════════════════════════
# Wird vor jedem `git commit` ausgeführt.
#
# 0. Maintainer-Identity-Guard (NEU 2026-06-28): Verhindert dass Vercel
#    Deployment-Blocks durch falsche Commit-Email auftreten (Sprint-4/5
#    Folge-Issue: 12 commits wurden mit ci-validate@swingz.local authored,
#    Vercel blockte das Deployment). Failet sobald `git config user.email`
#    nicht die erwartete Maintainer-Email ist. Siehe CONTRIBUTING.md → Rule 9.
# 1. Prüft ob Änderungen in kritischen Pfaden vorliegen (lib/,
#    supabase/migrations/, package.json). Diese Pfade beeinflussen den
#    Next.js-Build-Cache (.next/cache) — bei Änderungen muss der Cache
#    geleert werden, damit keine stale Module committet+gebaut werden.
#
# 2. Führt lint-staged aus (ESLint + Prettier auf geänderte Dateien).
# ═══════════════════════════════════════════════...═

# Farben für Output
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# ═══ Schritt 0: Maintainer-Identity-Guard (NEU 2026-06-28) ══════════════
# Purpose: Verhindern dass Commits mit falscher Email gepusht werden.
# Behavior:
#   - fehlende user.email → fail mit Setup-Hinweis
#   - falsche user.email → fail mit Fix-Hinweis + Vercel-block-Warnung
#   - user.name mismatch → WARN (kein fail), da Name vs Email unterschiedlich
#     streng gehandhabt werden; nur Email blockiert Vercel
#
# ACHTUNG: `git commit --no-verify` umgeht diesen Guard komplett. Verwende
# --no-verify nur für WIP-Commits, die NICHT nach origin/main gehen. Commits
# für main MÜSSEN durch die vollständige Hook-Chain (cache-check + lint-staged
# + email-guard). --no-verify überspringt ALLE hooks — falsche Emails würden
# so ungehindert passieren und beim nächsten Vercel-Deployment einen Block
# auslösen.
# Source Maintainer-Identity Source-of-Truth
# (see scripts/_maintainer_identity.sh for the canonical values).
# Husky-pre-commit must NOT hardcode the email — if the maintainer's
# GitHub-account-email ever changes, only one file needs to update.
GIT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -n "${GIT_ROOT}" ] && [ -f "${GIT_ROOT}/scripts/_maintainer_identity.sh" ]; then
  . "${GIT_ROOT}/scripts/_maintainer_identity.sh"
  # EXPECTED_EMAIL, EXPECTED_NAME are now exported
else
  # Fallback: if scripts/_maintainer_identity.sh was deleted, hardcode
  # the last-known values so the hook still functions (with a clear warn).
  echo "${YELLOW}⚠️  Cannot source scripts/_maintainer_identity.sh — using fallback values.${NC}"
  echo "${YELLOW}   This file should exist in the repo; check it wasn't deleted.${NC}"
  EXPECTED_EMAIL="bartmz@gmx.de"
  EXPECTED_NAME="Bart Mz"
fi

CURRENT_EMAIL=$(git config user.email 2>/dev/null || echo "")
CURRENT_NAME=$(git config user.name 2>/dev/null || echo "")

if [ -z "$CURRENT_EMAIL" ]; then
  echo "${RED}❌ git config user.email ist NICHT gesetzt.${NC}"
  echo "${YELLOW}   Setze mit (eine der beiden Varianten):${NC}"
  echo "      git config user.email \"${EXPECTED_EMAIL}\"   # repo-local"
  echo "      git config --global user.email \"${EXPECTED_EMAIL}\"   # global"
  echo "${YELLOW}   Mehr Infos: CONTRIBUTING.md → Rule 9: Maintainer git-identity policy${NC}"
  exit 1
fi

if [ "$CURRENT_EMAIL" != "${EXPECTED_EMAIL}" ]; then
  echo "${RED}❌ Falsche Commit-Email: \"${CURRENT_EMAIL}\"${NC}"
  echo "${YELLOW}   Erwartet:                \"${EXPECTED_EMAIL}\"${NC}"
  echo ""
  echo "${YELLOW}   Vercel würde das Deployment blocken mit:${NC}"
  echo "     'The deployment was blocked because the commit author email${NC}"
  echo "      ... is not valid. Ensure your git email matches your GitHub${NC}"
  echo "      account.'${NC}"
  echo ""
  echo "${YELLOW}   Fix (eine der drei):${NC}"
  echo "      git config user.email \"${EXPECTED_EMAIL}\"            # repo-local, persistent"
  echo "      git config --global user.email \"${EXPECTED_EMAIL}\"   # alle Repos"
  echo "      GIT_AUTHOR_EMAIL=\"${EXPECTED_EMAIL}\" GIT_COMMITTER_EMAIL=\"${EXPECTED_EMAIL}\" git commit ..."
  echo ""
  echo "${YELLOW}   Mehr Infos: CONTRIBUTING.md → Rule 9${NC}"
  exit 1
fi

# Name mismatch: WARN-only (kein fail). Email allein triggert Vercel-block.
if [ -n "${CURRENT_NAME}" ] && [ "${CURRENT_NAME}" != "${EXPECTED_NAME}" ]; then
  echo "${YELLOW}⚠️  git config user.name = \"${CURRENT_NAME}\" (erwartet: \"${EXPECTED_NAME}\")${NC}"
  echo "${YELLOW}   Hinweis: Name mismatch blockiert KEIN deployment.${NC}"
  echo "${YELLOW}   Für konsistente Audit-Trail besser angleichen:${NC}"
  echo "      git config user.name \"${EXPECTED_NAME}\""
fi

# ═══ Schritt 1: Cache-Invalidierung bei kritischen Änderungen ═══════════
echo "${BLUE}🔍 Prüfe auf Cache-relevante Änderungen...${NC}"

# Hole staged files (nur Added/Modified, keine Deleted)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null)

if [ -z "$STAGED_FILES" ]; then
  echo "${YELLOW}⚠️  Keine gestageten Dateien gefunden — überspringe Cache-Check.${NC}"
else
  # Filter auf kritische Pfade: lib/, supabase/migrations/, package.json
  CRITICAL_CHANGES=$(echo "$STAGED_FILES" | grep -E '^(lib/|supabase/migrations/|package\.json)' || true)

  if [ -n "$CRITICAL_CHANGES" ]; then
    echo "${YELLOW}⚠️  Cache-relevante Änderungen erkannt:${NC}"
    echo "$CRITICAL_CHANGES" | sed 's/^/   • /'
    echo ""

    if [ -d ".next/cache" ]; then
      echo "${BLUE}🧹 Lösche .next/cache (verhindert stale Module im nächsten Build)...${NC}"
      rm -rf .next/cache
      if [ $? -eq 0 ]; then
        echo "${GREEN}✅ .next/cache erfolgreich gelöscht${NC}"
      else
        echo "${RED}❌ Fehler beim Löschen von .next/cache — Commit wird trotzdem fortgesetzt${NC}"
      fi
    else
      echo "${BLUE}ℹ️  .next/cache existiert nicht — kein Cleanup nötig${NC}"
    fi

    # Optional: Auch den SWC-Cache leeren (häufig bei lib/ Änderungen problematisch)
    if [ -d ".swc" ]; then
      echo "${BLUE}🧹 Lösche .swc Cache...${NC}"
      rm -rf .swc
    fi

    # Optional: TypeScript incremental build info
    if ls *.tsbuildinfo 1> /dev/null 2>&1; then
      echo "${BLUE}🧹 Lösche *.tsbuildinfo...${NC}"
      rm -f *.tsbuildinfo
    fi
  else
    echo "${GREEN}✅ Keine Cache-relevanten Änderungen — Cache bleibt unverändert.${NC}"
  fi
fi

echo ""

# ═══ Schritt 2: lint-staged (bestehende Logik) ═════════════════════════
echo "${BLUE}🎨 Führe lint-staged aus...${NC}"
npx lint-staged
LINT_EXIT=$?

if [ $LINT_EXIT -ne 0 ]; then
  echo "${RED}❌ lint-staged fehlgeschlagen (Exit $LINT_EXIT) — Commit abgebrochen${NC}"
  exit $LINT_EXIT
fi

# ═══ Schritt 3: Doku-Regeln (nur wenn .md-Dateien betroffen sind) ══════
# Purpose: AGENTS.md → Dokumentations-Regeln maschinell durchsetzen. Die
# Regeln standen monatelang als Prosa da und wurden trotzdem mehrfach
# gebrochen (ROUTING.md/ROUTING2.md, DESIGN.md/DESIGN_KONZEPT.md,
# TEST-CREDENTIALS.md/TESTZUGAENGE.md). Prüft Dubletten-Namen, fehlende
# Index-Einträge, tote Links und das ADR-Schema.
MD_CHANGES=$(echo "$STAGED_FILES" | grep -E '\.md$' || true)
if [ -n "$MD_CHANGES" ]; then
  echo ""
  echo "${BLUE}📚 Prüfe Doku-Regeln (AGENTS.md)...${NC}"
  npx tsx scripts/check-docs.ts
  DOCS_EXIT=$?
  if [ $DOCS_EXIT -ne 0 ]; then
    echo "${RED}❌ Doku-Regeln verletzt — Commit abgebrochen${NC}"
    echo "${YELLOW}   Details oben. Regeln: AGENTS.md → Dokumentations-Regeln${NC}"
    exit $DOCS_EXIT
  fi
fi

echo ""
echo "${GREEN}✅ Pre-commit Hook erfolgreich abgeschlossen${NC}"
exit 0
