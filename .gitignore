# ═══ Compiler / Linter / Bundler caches ═════════════════════════════════
# TypeScript incremental build info
*.tsbuildinfo
**/*.tsbuildinfo
tsconfig.tsbuildinfo

# ESLint cache (--cache flag)
.eslintcache
**/.eslintcache

# SWC (Rust-based compiler used by Next.js / Turbopack)
.swc/
**/.swc/

# MDX compilation cache
.mdx/
**/.mdx/
.mjs.map
**/*.mjs.map

# Python bytecode cache (audit-trail hygiene 2026-06-28:
# scripts/__pycache__/*.pyc surfaced as untracked. `**/__pycache__/`
# subsumes the root-level `__pycache__/` case (git `**` matches zero segments),
# so a single pattern + the canonical Python bytecode-cover triples suffice.
# *.pyd is a legitimate Windows-Python-extension binary (also bytecode-class) —
# bracket `[cod]` keeps it covered.
**/__pycache__/
*.py[cod]
*$py.class

# PWA generated files
public/sw.js
public/workbox-*.js

# Credentials and secrets (CRITICAL)
Zugansdaten*.txt
credentials*.txt
credentials.json
secrets.txt
*.key
*.pem
*.p12
*.pfx
*.cer
*.crt
*.der

# Seed output files (NEVER commit generated passwords)
scripts/seed-output.txt
scripts/seed-*.txt
scripts/**/output.txt

# Database dumps
*.sql
*.dump
*.backup

# Exception: Supabase migrations are versioned DB schema — must be tracked
!supabase/migrations/*.sql
!supabase/seed.sql
!supabase/tests/*.sql

